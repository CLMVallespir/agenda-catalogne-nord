// ============================================================
// WRANGLER.JSONC — la configuració del desplegament del Worker
//
// Només serveix per al camí «Connect to Git»: Cloudflare llegeix
// aquest fitxer a cada empenta i desplega el Worker sol. Si algun dia
// tornes al desplegament manual (enganxar el codi al tauler), aquest
// fitxer no molesta: simplement ningú no el llegeix.
//
// AQUÍ NO HI HA CAP SECRET, I NO N'HI POT HAVER CAP: aquest fitxer és
// públic com tot el repositori. Les tres claus (GEMINI_API_KEY,
// GITHUB_TOKEN i ADRECA_ARXIU) viuen als Secrets del tauler i no
// surten mai d'allà. Vegeu docs/pas-fase2-worker-email.md.
//
// L'única variable que sí que viu aquí és CLOUDINARY_CLOUD_NAME, i el
// perquè és important: `wrangler deploy` esborra les variables de text
// posades al tauler cada vegada que desplega. Una variable de text que
// no sigui secreta, per tant, s'ha de declarar aquí o desapareixerà al
// pròxim desplegament. Els Secrets no: aquells wrangler no els toca.
//
// NO HI HA CAP CLAU `assets`, I NO N'HI HA D'HAVER MAI.
// Declarar-la faria que Cloudflare pugés fitxers d'aquest repositori
// com a pàgina web pública: amb `"directory": "."` hi entrarien
// l'historial de Git, els documents interns i el CSV d'importació.
// El web públic es serveix des de GitHub Pages i prou (CLAUDE.md §8).
// La segona barrera contra això és el `.assetsignore` de l'arrel.
// ============================================================
{
  // Ha de ser EXACTAMENT el nom del Worker al tauler de Cloudflare.
  // Si no coincideix, la construcció falla amb un error d'això.
  "name": "agenda-catalogne-nord",

  // El punt d'entrada. Wrangler l'empaqueta amb esbuild, així que
  // l'`import` de './postal-mime.js' es resol sol: els dos fitxers
  // pugen com un de sol sense que ningú hagi de concatenar res.
  "main": "worker/worker.js",

  // La data que fixa el comportament del temps d'execució. Deixa-la
  // quieta: canviar-la pot canviar el comportament de coses ja
  // provades. Només s'apuja a posta, i tornant a provar la Fase 2.
  "compatibility_date": "2026-08-27",

  // L'ACTIVADOR DEL DIGEST (Fase 3b). El cron de Cloudflare és
  // SEMPRE en UTC i no sap res de l'horari d'estiu, i el digest ha de
  // sortir a les 15.00 de París tot l'any: 13.00 UTC a l'estiu, 14.00
  // UTC a l'hivern. No hi ha manera d'escriure això en una expressió
  // cron, així que es fa en dos temps: aquesta expressió desperta el
  // Worker cada deu minuts durant les DUES hores candidates dels
  // dimarts, i el gestor scheduled() mira quina hora és a París i
  // se'n torna a dormir si no són les 15 (vegeu horaDeParis a
  // worker/worker.js).
  //
  // Les sis despertades que sí que passen el porter no són cap
  // malbaratament: el pla gratuït només deixa 50 subpeticions per
  // execució, i com que la guarda d'idempotència és per persona,
  // cada despertada continua la feina per on la va deixar l'anterior.
  //
  // ATENCIÓ: aquest fitxer només el llegeix el camí «Connect to Git»,
  // que ara està DESCONNECTAT a posta. Mentre el desplegament es faci
  // a mà des del tauler, el cron s'ha d'afegir també al tauler
  // (Worker > Settings > Trigger Events > Cron Triggers) amb aquesta
  // mateixa expressió.
  "triggers": {
    "crons": ["*/10 13,14 * * 2"]
  },

  // El nom del cloud de Cloudinary. No és cap secret: surt sencer a
  // l'URL de cada cartell del web públic (mira events.json), i la
  // pujada és sense signatura. Viu aquí, i no al tauler, perquè les
  // variables de text del tauler no sobreviuen a un `wrangler deploy`.
  "vars": {
    "CLOUDINARY_CLOUD_NAME": "clm-agenda"
  },

  // Els registres, desats. Sense això només hi ha el flux en directe
  // del tauler, que serveix mentre el mires: un correu que falla a les
  // tres de la matinada no deixaria cap rastre, i la Fase 2 promet que
  // tot error queda registrat. Al pla gratuït són 200 000 entrades al
  // dia i es guarden 3 dies.
  "observability": {
    "enabled": true
  }
}
